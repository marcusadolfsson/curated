# Copy to .env. Docker Compose reads .env automatically; it is gitignored.
# Nothing here is read by the native Mac path, which uses deploy/mac/run.sh.

# The analysis agent's credentials. Make one with: claude setup-token
# This is the same long-lived token the Mac keeps at ~/.curated/claude-token,
# so you can reuse that file:  CLAUDE_CODE_OAUTH_TOKEN=$(cat ~/.curated/claude-token)
# Billed to your plan. ANTHROPIC_API_KEY works too and is billed per request.
CLAUDE_CODE_OAUTH_TOKEN=

# Where the database, media and Instagram session live on the host.
CURATED_DATA=./data

# Published on loopback only.
INSTA_PORT=3010

# The report buckets send times in local time; containers default to UTC.
TZ=America/New_York

# Each post is described by its own agent process.
ANALYSIS_CONCURRENCY=3
