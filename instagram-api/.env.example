# Copy to .env (or let start.sh generate the API key on first run)
IG_API_KEY=replace-with-a-long-random-secret
PORT=8000
DM_POLL_SECONDS=300
# Reverse tunnel target: your Mac's user and Tailscale IP. Required by mac-tunnel.sh.
MAC_SSH_TARGET=user@<mac-tailscale-ip>
# Optional: pin a specific Instagram account. Defaults to the first connected account.
# IG_ACCOUNT_ID=
